# Copy this file to ".env" and fill in your values. NEVER share, screenshot or upload .env
BOT_TOKEN=paste_your_NEW_botfather_token_here
# Your own Telegram numeric user id (get it from @userinfobot). Multiple ids: 123,456
ADMIN_IDS=
SUPPORT_USERNAME=your_support_username
UPI_ID=yourupi@bank
DATABASE_URL=sqlite+aiosqlite:///./creative_agency.db
# Supplier API key (Silvex reseller key). Leave empty to run with the DUMMY supplier.
SILVEX_API_KEY=

# --- Automatic payment verification (optional, see README) ---
# A long random secret (20+ characters). Leave empty to disable the webhook server.
WEBHOOK_SECRET=
WEBHOOK_PORT=8080
# Part of your bank's SMS sender name, e.g. HDFCBK or SBIUPI. Comma separated.
BANK_SMS_SENDERS=
# Payments above this amount (in rupees) are never auto-approved.
AUTO_APPROVE_MAX_RS=2000

# --- Sales feed channel (optional) ---
# Channel where every purchase is announced. Use @channelusername (public channel) or the numeric id (-100...).
# The bot must be an ADMIN of the channel with permission to post.
SALES_CHANNEL=

# --- Force join (optional) ---
# Customers must join this channel before using the bot. The bot must be an ADMIN of the channel.
# Public: @mychannel     Private: -1001234567890|https://t.me/+InviteLink     Several: comma separated
FORCE_JOIN_CHANNELS=
